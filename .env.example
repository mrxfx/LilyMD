# Lily MD ✨🌸 — AYHA AI
BOT_NAME=Lily MD ✨🌸
AI_NAME=AYHA
BOT_OWNER=Rahul Haldar
OWNER_NUMBER=916033352400
OWNER_NUMBERS=916033352400,916033271400
SECONDARY_OWNERS=916033271400
WEBSITE_URL=https://lilymd.onrender.com
GITHUB_REPO=mrxfx/LilyMD

# AI providers — Central API Key configuration
# Each provider has up to 4 models and up to 4 shared API keys (Key 1 = Primary, Keys 2-4 = Backups).
# API keys are SHARED across models for each provider.
# You can set keys here or directly from WhatsApp using:
#   .aiprovider key groq 1 YOUR_GROQ_API_KEY
#   .aiprovider key gemini 1 YOUR_GEMINI_API_KEY
#
# --- Groq (4 Selectable Models, 4 Shared Keys) ---
GROQ_MODEL_1=openai/gpt-oss-20b
GROQ_MODEL_2=openai/gpt-oss-120b
GROQ_MODEL_3=qwen/qwen3.8-27b
GROQ_MODEL_4=meta-models/muse-spark-open

GROQ_API_KEY_1=YOUR_PRIMARY_GROQ_KEY
GROQ_API_KEY_2=YOUR_BACKUP_GROQ_KEY_2
GROQ_API_KEY_3=YOUR_BACKUP_GROQ_KEY_3
GROQ_API_KEY_4=YOUR_BACKUP_GROQ_KEY_4

# --- Google Gemini (4 Selectable Models, 4 Shared Keys) ---
GEMINI_MODEL_1=gemini-3.6-flash
GEMINI_MODEL_2=gemini-3.1-flash-lite
GEMINI_MODEL_3=gemini-3.5-flash
GEMINI_MODEL_4=gemini-3.5-flash-lite

GEMINI_API_KEY_1=YOUR_PRIMARY_GEMINI_KEY
GEMINI_API_KEY_2=YOUR_BACKUP_GEMINI_KEY_2
GEMINI_API_KEY_3=YOUR_BACKUP_GEMINI_KEY_3
GEMINI_API_KEY_4=YOUR_BACKUP_GEMINI_KEY_4

# --- Custom OpenAI-Compatible Provider (4 Selectable Models, 4 Shared Keys) ---
CUSTOM_BASE_URL=https://openrouter.ai/api/v1
CUSTOM_MODEL_1=openrouter/free
CUSTOM_MODEL_2=meta-llama/llama-3.3-70b-instruct
CUSTOM_MODEL_3=deepseek/deepseek-chat
CUSTOM_MODEL_4=mistralai/mistral-7b-instruct

CUSTOM_API_KEY_1=YOUR_PRIMARY_CUSTOM_KEY
CUSTOM_API_KEY_2=YOUR_BACKUP_CUSTOM_KEY_2
CUSTOM_API_KEY_3=YOUR_BACKUP_CUSTOM_KEY_3
CUSTOM_API_KEY_4=YOUR_BACKUP_CUSTOM_KEY_4

# Shorthand fallback keys (optional)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Slot-specific override keys (optional; defaults fall back to provider keys above)
# AI_PRIMARY_API_KEY=
# AI_FALLBACK_1_API_KEY=
# AI_FALLBACK_2_API_KEY=

# MySQL (OptikLink) — placeholders only, set the real values in the panel.
# AYHA memory and the scheduling queue live in these tables.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Scheduling
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULE_TICK_MS=15000
SCHEDULE_MEDIA_MAX_MB=16

# AYHA behaviour
# Conversation memory and the learned style are mirrored to MySQL and cached in data/ (gitignored).
AI_DAILY_LIMIT=30
AI_PERSONALITY_MODE=companion

# Auto-reply configuration
AUTO_REPLY_MODE=PRIVATE
AI_AUTO_REPLY=false
AI_AUTO_REPLY_API_KEY=
AI_AUTO_REPLY_MODEL=

# Optional fallback provider keys
OPENAI_API=
GEMINI_API=
CLAUDE_API=

# Optional media / utility integrations
TENOR_API_KEY=
OPENWEATHER_API_KEY=
ATLAS_FAA_URL=https://api-faa.my.id/faa
ATLAS_NEXRAY_URL=https://api.nexray.web.id/downloader
ATLAS_TIKWM_URL=https://tikwm.com/api/

# Website / dashboard deployment
PORT=8080
WEB_PORT=3000
BACKEND_API_URL=
FRONTEND_ORIGIN=https://lilymd.onrender.com
SESSION_TTL_HOURS=12

# WhatsApp session persistence (see README "Session persistence")
# Paste the contents of LILY-MD-SESSION.txt here to restore a linked session.
SESSION_ID=
# Optional tuning, in milliseconds: write debounce, periodic backup, send retry
SESSION_BACKUP_DEBOUNCE_MS=20000
SESSION_BACKUP_INTERVAL_MS=21600000
SESSION_BACKUP_RETRY_MS=600000

# Optional community links
CHANNEL_LINK=
SUPPORT_GROUP_LINK=
NEWSLETTER_JID=
UPDATE_ZIP_URL=
NEWS_API_KEY=
