# Lily MD ✨🌸 — AYHA AI
BOT_NAME=Lily MD ✨🌸
AI_NAME=AYHA
BOT_OWNER=Rahul Haldar
OWNER_NUMBER=916033352400
OWNER_NUMBERS=916033352400,916033271400
SECONDARY_OWNERS=916033271400
WEBSITE_URL=https://lilymd.onrender.com
GITHUB_REPO=mrxfx/LilyMD

# AI providers — three ordered slots (primary -> fallback 1 -> fallback 2).
# Base URL, model, vision flag and the failover order live in
# config/aiProviders.json (or Dashboard > AI Brain / .aiprovider).
# Keys may be saved in the dashboard (data/aiProviders.json, gitignored) or here.
AI_PRIMARY_API_KEY=
AI_FALLBACK_1_API_KEY=
AI_FALLBACK_2_API_KEY=

# Legacy single-provider selection (still used as a fallback for slot 1)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional provider keys
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct
# OPENAI_API_KEY=
# GROQ_API_KEY=
# AI_CUSTOM_API_KEY=

# MySQL (OptikLink) — placeholders only, set the real values in the panel.
# AYHA memory and the scheduling queue live in these tables.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Scheduling
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULE_TICK_MS=15000
SCHEDULE_MEDIA_MAX_MB=16

# AYHA behaviour
# Conversation memory and the learned style are mirrored to MySQL and cached in data/ (gitignored).
AI_DAILY_LIMIT=30
AI_PERSONALITY_MODE=companion

# Auto-reply configuration
AUTO_REPLY_MODE=PRIVATE
AI_AUTO_REPLY=false
AI_AUTO_REPLY_API_KEY=
AI_AUTO_REPLY_MODEL=

# Optional fallback provider keys
OPENAI_API=
GEMINI_API=
CLAUDE_API=

# Optional media / utility integrations
TENOR_API_KEY=
OPENWEATHER_API_KEY=
ATLAS_FAA_URL=https://api-faa.my.id/faa
ATLAS_NEXRAY_URL=https://api.nexray.web.id/downloader
ATLAS_TIKWM_URL=https://tikwm.com/api/

# Website / dashboard deployment
PORT=8080
WEB_PORT=3000
BACKEND_API_URL=
FRONTEND_ORIGIN=https://lilymd.onrender.com
SESSION_TTL_HOURS=12

# WhatsApp session persistence (see README "Session persistence")
# Paste the contents of LILY-MD-SESSION.txt here to restore a linked session.
SESSION_ID=
# Optional tuning, in milliseconds: write debounce, periodic backup, send retry
SESSION_BACKUP_DEBOUNCE_MS=20000
SESSION_BACKUP_INTERVAL_MS=21600000
SESSION_BACKUP_RETRY_MS=600000

# Optional community links
CHANNEL_LINK=
SUPPORT_GROUP_LINK=
NEWSLETTER_JID=
UPDATE_ZIP_URL=
NEWS_API_KEY=
