# AYHA AI assistant (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Max AYHA requests per user per day (0 = unlimited; owner/sudo exempt)
AI_DAILY_LIMIT=30
# Private-chat AYHA auto-reply (you can also toggle it live with .aiutoreply on)
# AI_AUTO_REPLY=false
# Optional dedicated key/model for auto-reply (falls back to OPENROUTER_API_KEY)
# AI_AUTO_REPLY_API_KEY=
# AI_AUTO_REPLY_MODEL=

# Project
# BOT_OWNER=Rahul Haldar
# GITHUB_REPO=owner/repo
# Public website / dashboard (also used as the AI request referer)
# WEBSITE_URL=https://lilymd.vercel.app
# UPDATE_ZIP_URL=
# CHANNEL_LINK=https://whatsapp.com/channel/your-channel
# SUPPORT_GROUP_LINK=https://chat.whatsapp.com/your-invite
# NEWSLETTER_JID=1234567890@newsletter

# Atlas API layer (endpoints: lib/atlasApi.js)
# Tenor key(s) for GIF / emoji-mix commands, comma-separated
# TENOR_API_KEY=AIzaSy...
# OpenWeather key for .weather
# OPENWEATHER_API_KEY=
# AI provider key pools used as AYHA fallbacks, comma-separated
# OPENAI_API=sk-...
# GEMINI_API=
# CLAUDE_API=

# Hosting
# PORT=8080 (bot + pairing website)
# SESSION_ID=base64-of-session-backup

# Standalone website without the bot (npm run website)
# WEB_PORT=3000
