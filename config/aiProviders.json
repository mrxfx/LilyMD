{
  "version": 2,
  "providerPriority": ["groq", "gemini", "custom"],
  "order": ["primary", "fallback1", "fallback2"],
  "fast": { "maxTokens": 320, "timeoutMs": 22000 },
  "detailed": { "maxTokens": 1100, "timeoutMs": 90000 },
  "slots": [
    {
      "id": "primary",
      "label": "Primary",
      "provider": "groq",
      "baseUrl": "https://api.groq.com/openai/v1",
      "model": "openai/gpt-oss-20b",
      "apiKeyEnv": "GROQ_API_KEY",
      "vision": false,
      "enabled": true
    },
    {
      "id": "fallback1",
      "label": "Fallback 1",
      "provider": "gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "model": "gemini-3.6-flash",
      "apiKeyEnv": "GEMINI_API_KEY",
      "vision": true,
      "enabled": true
    },
    {
      "id": "fallback2",
      "label": "Fallback 2",
      "provider": "custom",
      "baseUrl": "https://openrouter.ai/api/v1",
      "model": "openrouter/free",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "vision": false,
      "enabled": true
    }
  ]
}
