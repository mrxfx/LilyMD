{
  "version": 1,
  "order": ["primary", "fallback1", "fallback2"],
  "fast": { "maxTokens": 320, "timeoutMs": 22000 },
  "detailed": { "maxTokens": 1100, "timeoutMs": 90000 },
  "slots": [
    {
      "id": "primary",
      "label": "Primary",
      "provider": "openrouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "model": "openrouter/free",
      "apiKeyEnv": "AI_PRIMARY_API_KEY",
      "vision": false,
      "enabled": true
    },
    {
      "id": "fallback1",
      "label": "Fallback 1",
      "provider": "gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "model": "gemini-2.0-flash",
      "apiKeyEnv": "AI_FALLBACK_1_API_KEY",
      "vision": true,
      "enabled": false
    },
    {
      "id": "fallback2",
      "label": "Fallback 2",
      "provider": "custom",
      "baseUrl": "",
      "model": "",
      "apiKeyEnv": "AI_FALLBACK_2_API_KEY",
      "vision": false,
      "enabled": false
    }
  ]
}
